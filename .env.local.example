ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Optional: Payment setup ──────────────────────────────────────────────────
# Set these to enable Stripe payment gating:
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYMENT_TOKEN_SECRET=some_long_random_string
# STRIPE_PAYMENT_LINK=https://buy.stripe.com/...

# ── Dev / testing: skip the payment gate ────────────────────────────────────
# Set to "true" to bypass the payment check entirely (local dev only).
# Never set this in production — anyone who knows this flag can access the app.
# BYPASS_PAYMENT=true
